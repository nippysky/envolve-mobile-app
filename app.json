{
  "expo": {
    "name": "EnvolveCare Plus",
    "slug": "envolvecare-plus",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "envolvecareplus",
    "userInterfaceStyle": "light",

    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4f46e5"
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.envolvepharma.envolvecareplus",
      "buildNumber": "1",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "We use your camera to scan prescriptions and QR codes.",
        "NSPhotoLibraryUsageDescription": "We access your photo library so you can upload prescription images.",
        "NSLocationWhenInUseUsageDescription": "We use your location to estimate delivery times and show nearby pharmacies.",
        "NSFaceIDUsageDescription": "We use Face ID to securely authenticate your account.",
        "NSUserTrackingUsageDescription": "We use this to deliver relevant content and improve your experience.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "android": {
      "package": "com.envolvepharma.envolvecareplus",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#4f46e5"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4f46e5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "eas": {
        "projectId": "your-eas-project-id-here"
      }
    },

    "owner": "envolvepharma"
  }
}
