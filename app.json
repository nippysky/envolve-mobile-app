{
  "expo": {
    "name": "EnvolveCare Plus",
    "slug": "envolvecare-plus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "envolvecareplus",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.envolvepharma.envolvecareplus",
      "infoPlist": {
        "NSCameraUsageDescription": "EnvolveCare Plus uses your camera to scan prescriptions and barcodes.",
        "NSPhotoLibraryUsageDescription": "EnvolveCare Plus accesses your photo library so you can upload prescription images.",
        "NSLocationWhenInUseUsageDescription": "EnvolveCare Plus uses your location to estimate delivery times and find nearby options.",
        "NSFaceIDUsageDescription": "EnvolveCare Plus uses Face ID to securely sign you in.",
        "NSUserTrackingUsageDescription": "This helps us show you relevant products and improve your experience.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.envolvepharma.envolvecareplus",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00a6d4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "url": "https://u.expo.dev/859a57dc-55ec-432c-a774-07f07495da25"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "859a57dc-55ec-432c-a774-07f07495da25"
      }
    },
    "owner": "nippysky"
  }
}
